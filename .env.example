# ============================================
# Fairtune - Environment Configuration
# ============================================
# Copy this to .env and fill in your values
# .env files are gitignored — never commit secrets

# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Resend Email
RESEND_API_KEY=re_xxx
CONTACT_EMAIL=hello@fairtune.fm
RESEND_FROM_EMAIL=Fairtune <noreply@notifications.fairtune.fm>

# Stripe Configuration
# Dev: use pk_test_ / sk_test_ keys
# Prod: use pk_live_ / sk_live_ keys
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_xxx
STRIPE_BOOST_PRICE_5=price_xxx
STRIPE_BOOST_PRICE_10=price_xxx
STRIPE_BOOST_PRICE_20=price_xxx

# Cloudflare R2 Configuration
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=indiestream-audio
R2_ACCOUNT_ID=your-account-id

# Application
APP_URL=http://localhost:3000
NODE_ENV=development
COMING_SOON_MODE=false

# E2E Testing (optional)
TEST_USER_EMAIL=test@test.test
TEST_USER_PASSWORD=testpassword
TEST_ADMIN_EMAIL=admin@test.test
TEST_ADMIN_PASSWORD=adminpassword

# Fly.io Transcoding
TRANSCODING_SECRET=your-transcoding-secret
